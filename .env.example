# Runtime mode: fixture is deterministic and requires no external credentials.
APP_MODE=fixture
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api

# DataHub mode (leave blank in fixture mode).
DATAHUB_GMS_URL=
DATAHUB_TOKEN=

# Model-backed reasoning (not required during Phase 0).
OPENAI_API_KEY=

# Local Codex process environment for the optional Stitch design MCP.
# Do not place a real value in a tracked file. Set STITCH_API_KEY in the OS environment.
STITCH_API_KEY=

# Safety limits.
MAX_LINEAGE_DEPTH=3
MAX_LINEAGE_ENTITIES=100
MAX_TOOL_CALLS=20
INVESTIGATION_TIMEOUT_MS=30000
