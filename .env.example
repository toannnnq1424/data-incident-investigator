# Runtime mode: fixture is deterministic and requires no external credentials.
APP_MODE=fixture
API_HOST=127.0.0.1
API_PORT=3001
# Reserved for host/proxy documentation; the current API does not read this value or enable CORS.
WEB_ORIGIN=http://localhost:5173
# Web build-time only. Release artifacts pin this to the same-origin proxy path /api.
VITE_API_BASE_URL=/api

# Direct DataHub GraphQL mode (leave blank in fixture mode).
DATAHUB_GMS_URL=

# Shared DataHub secret. Required by direct GraphQL mode and by MCP bearer mode.
# Leave blank for fixture mode and for a trusted local MCP endpoint using auth mode "none".
DATAHUB_TOKEN=

# DataHub MCP Server mode. The application accepts Streamable HTTP only and never starts a process.
# DATAHUB_MCP_URL must be an exact absolute http(s) endpoint without credentials, query, or fragment.
# DATAHUB_MCP_AUTH_MODE must be exactly "none" or "bearer" when APP_MODE=datahub-mcp.
DATAHUB_MCP_URL=
DATAHUB_MCP_AUTH_MODE=
DATAHUB_MCP_TIMEOUT_MS=5000
DATAHUB_MCP_MAX_RESPONSE_BYTES=262144

# Model-backed reasoning (not required or used by any current investigation mode).
OPENAI_API_KEY=

# Local Codex process environment for the optional Stitch design MCP.
# Do not place a real value in a tracked file. Set STITCH_API_KEY in the OS environment.
STITCH_API_KEY=

# Safety limits.
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=12
MAX_LINEAGE_DEPTH=3
MAX_ENTITIES_PER_QUERY=30
MAX_RETRIES=2
AGENT_TIMEOUT_SECONDS=90
MAX_MODEL_OUTPUT_BYTES=65536

# Public JSON ingress (process-local fixed-window limiter; POST routes only).
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Legacy fallbacks (leave unset when the canonical replacement above is set).
# MAX_LINEAGE_ENTITIES is the legacy name for MAX_ENTITIES_PER_QUERY.
# INVESTIGATION_TIMEOUT_MS is the legacy millisecond form of AGENT_TIMEOUT_SECONDS.
# MAX_LINEAGE_ENTITIES=
# INVESTIGATION_TIMEOUT_MS=
