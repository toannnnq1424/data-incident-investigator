{
  "name": "data-incident-investigator",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "AI-assisted data incident investigation using metadata, lineage, and change evidence.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dii/web --filter @dii/api dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e:report": "node tests/e2e/report-display.spec.mjs",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present build",
    "release:artifact": "node scripts/build-release-artifact.mjs",
    "release:verify": "node scripts/verify-release-artifact.mjs",
    "smoke": "node scripts/smoke.mjs",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
